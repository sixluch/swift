# ---- Database ----
# Local dev: Docker Postgres (backend/docker-compose.yml). Prod: Neon connection string.
DATABASE_URL=postgresql://chatbroker:chatbroker@localhost:5432/chatbroker

# ---- Vercel AI Gateway ----
# Paste your Vercel AI Gateway key here.
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-sonnet-5

# ---- Server ----
PORT=3001
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Branding / copy ----
BRAND_NAME=SwiftBrokers
ASSISTANT_NAME=Nomi
QUOTE_CURRENCY=USD

# ---- Admin console ----
# The account itself is created with `npm run admin:create -- <username>` —
# there is no default username or password anywhere in this repo.
ADMIN_SESSION_HOURS=8
# Production only: the shared registrable domain, so the session cookie set by
# api.example.com is sent by app.example.com. Leave empty for local dev.
ADMIN_COOKIE_DOMAIN=
# Defaults to true when NODE_ENV=production; set explicitly to override.
ADMIN_COOKIE_SECURE=
